<?xml version="1.0" encoding="UTF-8"?>
<svg
  xmlns="http://www.w3.org/2000/svg"
  width="800"
  height="800"
  viewBox="0 0 800 800"
>
  <!-- Background (dark) -->
  <rect width="800" height="800" fill="#050910"/>

  <!-- Chat bubble outline -->
  <rect x="90" y="90" width="230" height="260" rx="40" ry="40"
        fill="none" stroke="#d7dbe3" stroke-width="10"/>
  <!-- Bubble tail -->
  <path d="M210 350 L245 430 L280 350 Z"
        fill="#050910" stroke="#d7dbe3" stroke-width="10" stroke-linejoin="round"/>

  <!-- US flag circle inside bubble -->
  <circle cx="205" cy="220" r="80" fill="#d7dbe3"/>

  <!-- Flag stripes -->
  <g transform="translate(125,140)">
    <!-- red & white stripes -->
    <rect x="0" y="40" width="160" height="16" fill="#b22234"/>
    <rect x="0" y="56" width="160" height="16" fill="#ffffff"/>
    <rect x="0" y="72" width="160" height="16" fill="#b22234"/>
    <rect x="0" y="88" width="160" height="16" fill="#ffffff"/>
    <rect x="0" y="104" width="160" height="16" fill="#b22234"/>
    <rect x="0" y="120" width="160" height="16" fill="#ffffff"/>
    <rect x="0" y="136" width="160" height="16" fill="#b22234"/>

    <!-- blue canton -->
    <rect x="0" y="0" width="70" height="72" fill="#3c3b6e"/>

    <!-- simple star grid (dots to keep it light) -->
    <g fill="#ffffff">
      <circle cx="8"  cy="10" r="2.1"/>
      <circle cx="22" cy="10" r="2.1"/>
      <circle cx="36" cy="10" r="2.1"/>
      <circle cx="50" cy="10" r="2.1"/>
      <circle cx="64" cy="10" r="2.1"/>

      <circle cx="15" cy="22" r="2.1"/>
      <circle cx="29" cy="22" r="2.1"/>
      <circle cx="43" cy="22" r="2.1"/>
      <circle cx="57" cy="22" r="2.1"/>

      <circle cx="8"  cy="34" r="2.1"/>
      <circle cx="22" cy="34" r="2.1"/>
      <circle cx="36" cy="34" r="2.1"/>
      <circle cx="50" cy="34" r="2.1"/>
      <circle cx="64" cy="34" r="2.1"/>

      <circle cx="15" cy="46" r="2.1"/>
      <circle cx="29" cy="46" r="2.1"/>
      <circle cx="43" cy="46" r="2.1"/>
      <circle cx="57" cy="46" r="2.1"/>

      <circle cx="8"  cy="58" r="2.1"/>
      <circle cx="22" cy="58" r="2.1"/>
      <circle cx="36" cy="58" r="2.1"/>
      <circle cx="50" cy="58" r="2.1"/>
      <circle cx="64" cy="58" r="2.1"/>
    </g>
  </g>

  <!-- Crop flag into circle -->
  <clipPath id="flagCircle">
    <circle cx="205" cy="220" r="80"/>
  </clipPath>
  <g clip-path="url(#flagCircle)">
    <!-- re-use the flag we drew above by referencing its group -->
    <!-- (for simplicity we re-draw; clipping hides any overflow) -->
  </g>

  <!-- MAIN TEXT BLOCK on the right -->
  <g fill="#f3f5f8" font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
     font-weight="700" letter-spacing="2">
    <text x="360" y="140" font-size="40">HABLANDO</text>
    <text x="360" y="190" font-size="40">DIRECTO</text>
    <text x="360" y="240" font-size="40">MAESTROS</text>
    <text x="360" y="290" font-size="36">INTERNACIONALES</text>
  </g>

  <!-- WORX (big) -->
  <text x="110" y="520"
        fill="#e2e4ea"
        font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        font-weight="800"
        font-size="150"
        letter-spacing="8">
    WORX
  </text>

  <!-- Bottom curve / base line -->
  <path d="M130 550 Q 400 620 670 550"
        fill="none" stroke="#d7dbe3" stroke-width="6" stroke-linecap="round"/>

  <!-- URL -->
  <text x="150" y="605"
        fill="#e2e4ea"
        font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        font-weight="700"
        font-size="34"
        letter-spacing="4">
    HDMIWORX.COM
  </text>
</svg>